{
  "title": "Almanac 今日簡報",
  "description": "NoteGen 今日簡報：闔上時下載到書庫（實驗）",
  "token": { "file": "token.json", "path": "token" },
  "config": { "file": "config.json" },
  "events": {
    "sleep.enter": {
      "download": {
        "url": "{cfg.server}/eink/today.epub?token={token}",
        "headers": { "Authorization": "Bearer {token}" },
        "dest": "/Books/Almanac/almanac-today.epub"
      }
    }
  }
}
